{
  "info": {
    "name": "Task Service API",
    "description": "CRUD-запросы к сервису задач (API -> PostgreSQL в Docker Compose). Запускать по порядку: Create task сохраняет id созданной задачи в переменную taskId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "taskId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Get all tasks",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/tasks"
      }
    },
    {
      "name": "Create task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('taskId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Prepare weekly report\",\n  \"description\": \"Collect team results for the week\",\n  \"isCompleted\": false\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/tasks"
      }
    },
    {
      "name": "Get task by id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      }
    },
    {
      "name": "Update task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Task is completed', () => pm.expect(pm.response.json().isCompleted).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Prepare weekly report\",\n  \"description\": \"Report sent to the manager\",\n  \"isCompleted\": true\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      }
    },
    {
      "name": "Delete task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      }
    }
  ]
}
